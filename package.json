{
  "name": "task-manager",
  "version": "1.0.0",
  "description": "A RESTful API for managing tasks with CRUD operations",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand --forceExit --detectOpenHandles"
  },
  "keywords": [
    "api",
    "tasks",
    "crud",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "mongoose": "^9.6.1"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "mongodb-memory-server": "^10.2.1",
    "supertest": "^7.2.2"
  }
}
